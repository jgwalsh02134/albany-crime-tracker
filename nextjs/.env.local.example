# Copy this file to .env.local and fill in the values.

# URL of the FastAPI backend (Albany Crime Tracker API server).
# In Railway, set this to the internal service URL, e.g.:
#   http://albany-crime-tracker.railway.internal:8080
# For local development:
#   http://localhost:8080
FASTAPI_URL=http://localhost:8080

# Exposed to the browser — used by client components for direct API calls.
# In production this should be the public URL of the FastAPI service or the
# Next.js app's own origin (since Next.js proxies /api/* to FastAPI).
NEXT_PUBLIC_API_URL=
