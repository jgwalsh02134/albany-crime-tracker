ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Albany Crime Tracker
APP_VERSION=1.0.0

# Core external APIs
XAI_API_KEY=
# Model for X.com live search via Responses API x_search tool (default: grok-4-1-fast)
XAI_RESPONSES_MODEL=grok-4-1-fast
FBI_API_KEY=
SOCRATA_APP_TOKEN=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Data/storage integrations (planned)
DATABASE_URL=
REDIS_URL=

# Persistence/cache behavior
# Database tables auto-create on startup when DATABASE_URL is set.
# Redis is preferred for cache + refresh lock; app falls back to in-memory cache if unavailable.

# Traffic data
# Used for 511NY GetEvents and GetCameras fusion.
511_NY_API_KEY=

# Mapping providers (Mapbox used for geocoding fallback)
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Scanner sources (Broadcastify + RadioReference)
# Apply at https://www.broadcastify.com/apply/calls for Broadcastify API key
BROADCASTIFY_API_KEY=
BROADCASTIFY_SYSTEM_ID=8553
# RadioReference SOAP talkgroup enrichment + Albany/Schenectady P25 registry (scanner_albany_p25_main).
# RadioReference: free API key at radioreference.com/account/api + premium account ($15/yr)
RADIOREFERENCE_API_KEY=
RADIOREFERENCE_USERNAME=
RADIOREFERENCE_PASSWORD=

# Observability / analytics (planned)
SENTRY_DSN=
POSTHOG_KEY=

# Superfeedr push ingestion
# SUPERFEEDR_LOGIN/TOKEN authenticate to https://push.superfeedr.com.
# SUPERFEEDR_SECRET is the shared hub.secret used for X-Hub-Signature HMAC-SHA1 verification.
# SUPERFEEDR_CALLBACK_BASE_URL is the public base URL that receives pushes at /api/superfeedr/webhook.
SUPERFEEDR_LOGIN=
SUPERFEEDR_TOKEN=
SUPERFEEDR_SECRET=
SUPERFEEDR_CALLBACK_BASE_URL=
# Required to call any /api/dev/superfeedr/* endpoint. Send as header: X-Admin-Token: <value>.
# Leave empty only in local dev; endpoints refuse to run when unset in any other environment.
SUPERFEEDR_ADMIN_TOKEN=
# Pilot-mode cap on total push subscriptions. 0 = uncapped. Set to 1 while the
# Superfeedr account plan only permits a single subscription.
SUPERFEEDR_MAX_SUBSCRIPTIONS=0

# HTTP and feature controls
EXTERNAL_TIMEOUT_SECONDS=20
EXTERNAL_RETRY_ATTEMPTS=3
FEATURE_AI_CHAT=true
FEATURE_SCANNER=true
FEATURE_LIVE_FEED=true
FEATURE_DIRECTORY=true
FEATURE_MAP=true

