ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Albany Crime Tracker
APP_VERSION=1.0.0

# Core external APIs
XAI_API_KEY=
FBI_API_KEY=
DATA_GOV_API_KEY=
SOCRATA_APP_TOKEN=
OPENROUTER_API_KEY=

# Data/storage integrations (planned)
DATABASE_URL=
REDIS_URL=

# Persistence/cache behavior
# Database tables auto-create on startup when DATABASE_URL is set.
# Redis is preferred for cache + refresh lock; app falls back to in-memory cache if unavailable.

# Mapping providers (planned)
MAPBOX_TOKEN=
GOOGLE_MAPS_API_KEY=

# Observability / analytics (planned)
SENTRY_DSN=
POSTHOG_KEY=

# HTTP and feature controls
EXTERNAL_TIMEOUT_SECONDS=20
EXTERNAL_RETRY_ATTEMPTS=3
FEATURE_AI_CHAT=true
FEATURE_SCANNER=true
FEATURE_LIVE_FEED=true
FEATURE_DIRECTORY=true
FEATURE_MAP=true

