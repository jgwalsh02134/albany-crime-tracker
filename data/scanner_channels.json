  "_meta": {
    "version": "2026.1",
    "scope": "Albany County, NY virtual scanner channels",
    "purpose": "Curated talkgroup → channel mapping for ACT scanner UI grouping. Each channel rolls one or more P25 talkgroups (from data/scanner_aliases.json) into a single user-facing view, with optional cross-reference to a canonical agency record (data/agencies.json).",
    "field_contract": {
      "channel_id": "stable kebab-case identifier; never reused if a channel is renamed",
      "label": "display name shown in the scanner UI",
      "agency_id": "data/agencies.json agency_id when 1:1; null for multi-agency rollups",
      "talkgroup_ids": "array of string talkgroup IDs that belong to this channel; must exist in data/scanner_aliases.json",
      "disciplines": "subset of [police, fire, ems]; multi means this channel mixes disciplines",
      "region": "capital_albany | bethlehem_area | colonie_area | guilderland_area | coeymans_ravena | cohoes_watervliet_green_island | hilltowns | thruway | capitol | county_wide",
      "priority": "high (high-frequency dispatch) | medium | low",
      "notes": "free text"
    }
  },
